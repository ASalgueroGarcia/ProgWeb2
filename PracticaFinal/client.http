@baseUrl = http://localhost:3000
@token = YOUR_JWT_TOKEN

### Health Check
GET {{baseUrl}}/health

### Registrar usuario
POST {{baseUrl}}/api/user/register
Content-Type: application/json

{
  "name": "Usuario Test",
  "email": "test@example.com",
  "password": "password123"
}

### Login
POST {{baseUrl}}/api/user/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

### Crear cliente
POST {{baseUrl}}/api/client
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Constructora García",
  "cif": "B12345678",
  "email": "contacto@garcia.com",
  "phone": "+34600000000",
  "address": {
    "street": "Calle Mayor",
    "number": "5",
    "postal": "28001",
    "city": "Madrid",
    "province": "Madrid"
  }
}

### Listar clientes (con paginación)
GET {{baseUrl}}/api/client?page=1&limit=10
Authorization: Bearer {{token}}

### Filtrar clientes por nombre
GET {{baseUrl}}/api/client?name=García&sort=-createdAt
Authorization: Bearer {{token}}

### Obtener cliente por ID
GET {{baseUrl}}/api/client/CLIENT_ID
Authorization: Bearer {{token}}

### Actualizar cliente
PUT {{baseUrl}}/api/client/CLIENT_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Constructora García Actualizada",
  "phone": "+34600000001"
}

### Eliminar cliente (soft)
DELETE {{baseUrl}}/api/client/CLIENT_ID?soft=true
Authorization: Bearer {{token}}

### Eliminar cliente (hard)
DELETE {{baseUrl}}/api/client/CLIENT_ID
Authorization: Bearer {{token}}

### Listar clientes archivados
GET {{baseUrl}}/api/client/archived
Authorization: Bearer {{token}}

### Restaurar cliente archivado
PATCH {{baseUrl}}/api/client/CLIENT_ID/restore
Authorization: Bearer {{token}}
